datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum TaskStatus {
  DRAFT
  PENDING_PAYMENT
  PENDING_REVIEW
  OPEN
  CLAIMED
  SUBMITTED
  REVISION_REQUESTED
  REJECTED_PENDING_APPEAL
  APPEALED
  COOLING
  COMPLETED
  CANCELLED
  REFUNDED
  CLOSED
}

enum TaskClaimOutcome {
  REJECTED
  APPROVED
  EXPIRED
  RELEASED
}

enum RechargeOrderStatus {
  CREATED
  PAID
  CLOSED
  REFUNDED
}

enum EscrowStatus {
  HELD
  RELEASED
  AWARDED
}

enum AwardStatus {
  COOLING
  BLOCKED
  CREDITED
}

enum WithdrawalStatus {
  REQUESTED
  TOKEN_ISSUED
  COMPLETED
  REJECTED
  CANCELLED
}

enum ActorSource {
  USER
  ADMIN
  SYSTEM
}

enum ContestStatus {
  DRAFT
  PENDING_PAYMENT
  OPEN
  JUDGING
  COOLING
  COMPLETED
  CANCELLED
  REFUNDED
  CLOSED
}

enum PrizeRank {
  FIRST
  SECOND
  THIRD
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  WITHDRAWN
}

enum FileStatus {
  UPLOADING
  READY
  ATTACHED
  ABORTED
  DELETED
}

enum FileKind {
  VIDEO
  ATTACHMENT
}

enum FileTargetType {
  TASK
  CONTEST
}

model User {
  id                      String              @id @default(uuid())
  publicNo                Int                 @unique @default(autoincrement())
  createdAt               DateTime            @default(now())
  email                   String?             @unique
  username                String?             @unique
  isAdmin                 Boolean             @default(false)
  isBanned                Boolean             @default(false)
  bannedReason            String?
  bio                     String?
  skills                  String[]            @default([])
  portfolioLinks          String[]            @default([])
  avatarUrl               String?
  publishedTasks          UserTask[]          @relation("PublishedTasks")
  submissions             Submission[]
  files                   File[]
  wallet                  WalletAccount?
  walletEntries           WalletEntry[]
  rechargeOrders          RechargeOrder[]
  escrows                 TaskEscrow[]        @relation("EscrowPublisher")
  awards                  Award[]             @relation("AwardRecipient")
  withdrawalRequests      WithdrawalRequest[] @relation("WithdrawalOwner")
  administeredWithdrawals WithdrawalRequest[] @relation("WithdrawalAdmin")
  feeConfigsUpdated       FeeConfig[]
  systemSettingsUpdated   SystemSetting[]
  refundsAdministered     RefundRecord[]
  taskEvents              TaskEvent[]
  taskClaims              TaskClaim[]         @relation("TaskClaimWorker")
  taskQuestionsAsked      TaskQuestion[]      @relation("TaskQuestionAsker")
  taskQuestionsAnswered   TaskQuestion[]      @relation("TaskQuestionAnswerer")
  contestQuestionsAsked   ContestQuestion[]   @relation("ContestQuestionAsker")
  contestQuestionsAnswered ContestQuestion[]  @relation("ContestQuestionAnswerer")
  reviewsWritten          WorkReview[]        @relation("ReviewsWritten")
  reviewsReceived         WorkReview[]        @relation("ReviewsReceived")
  publishedContests       Contest[]           @relation("PublishedContests")
  contestEntries          ContestEntry[]
  contestEscrows          ContestEscrow[]      @relation("ContestEscrowPublisher")
  contestAwards           ContestAward[]       @relation("ContestAwardRecipient")
  notificationPreference  NotificationPreference?
  announcementsPublished Announcement[]       @relation("AnnouncementPublisher")
  giftCardBatchesCreated GiftCardBatch[]       @relation("GiftCardBatchCreator")
  giftCardsRedeemed      GiftCard[]            @relation("GiftCardRedeemer")
}

model NotificationPreference {
  id               String   @id @default(uuid())
  userId           String   @unique
  taskEmails       Boolean  @default(true)
  contestEmails    Boolean  @default(true)
  walletEmails     Boolean  @default(true)
  announcementEmails Boolean @default(true)
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Announcement {
  id          String             @id @default(uuid())
  title       String
  summary     String
  content     String
  status      AnnouncementStatus @default(DRAFT)
  isPinned    Boolean            @default(false)
  publishedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  publisherId String
  publisher   User               @relation("AnnouncementPublisher", fields: [publisherId], references: [id])

  @@index([status, isPinned, publishedAt])
}

model Contest {
  id                 String          @id @default(uuid())
  publicNo           Int             @unique @default(autoincrement())
  publisherId        String
  title              String
  description        String
  totalPrizeCents    Int
  submissionDeadline DateTime
  status             ContestStatus   @default(DRAFT)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  publisher          User            @relation("PublishedContests", fields: [publisherId], references: [id])
  prizes             ContestPrize[]
  entries            ContestEntry[]
  escrow             ContestEscrow?
  awards             ContestAward[]
  questions          ContestQuestion[]

  @@index([status, createdAt])
  @@index([publisherId, createdAt])
}

model ContestPrize {
  id            String        @id @default(uuid())
  contestId     String
  rank          PrizeRank
  amountCents   Int
  winnerEntryId String?       @unique
  contest       Contest       @relation(fields: [contestId], references: [id])
  winner        ContestEntry? @relation("ContestPrizeWinner", fields: [winnerEntryId], references: [id])
  award         ContestAward?

  @@unique([contestId, rank])
}

model ContestEntry {
  id          String        @id @default(uuid())
  contestId   String
  entrantId   String
  submittedAt DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  shortlisted Boolean       @default(false)
  privateFeedback String?
  contest     Contest       @relation(fields: [contestId], references: [id])
  entrant     User          @relation(fields: [entrantId], references: [id])
  wonPrize    ContestPrize? @relation("ContestPrizeWinner")
  versions    ContestEntryVersion[]

  @@unique([contestId, entrantId])
  @@index([entrantId, submittedAt])
}

model ContestEntryVersion {
  id             String       @id @default(uuid())
  contestEntryId String
  content        String
  version        Int
  createdAt      DateTime     @default(now())
  contestEntry   ContestEntry @relation(fields: [contestEntryId], references: [id], onDelete: Cascade)
  files          File[]

  @@unique([contestEntryId, version])
  @@index([contestEntryId, createdAt])
}

model ContestEscrow {
  id            String       @id @default(uuid())
  contestId     String       @unique
  publisherId   String
  rechargeCents Int
  earningsCents Int
  totalCents    Int
  status        EscrowStatus @default(HELD)
  heldAt        DateTime     @default(now())
  releasedAt    DateTime?
  contest       Contest      @relation(fields: [contestId], references: [id])
  publisher     User         @relation("ContestEscrowPublisher", fields: [publisherId], references: [id])
}

model ContestAward {
  id            String      @id @default(uuid())
  contestId     String
  prizeId       String      @unique
  recipientId   String
  amountCents   Int
  status        AwardStatus @default(COOLING)
  availableAt   DateTime
  blockedReason String?
  creditedAt    DateTime?
  contest       Contest     @relation(fields: [contestId], references: [id])
  prize         ContestPrize @relation(fields: [prizeId], references: [id])
  recipient     User        @relation("ContestAwardRecipient", fields: [recipientId], references: [id])

  @@index([status, availableAt])
  @@index([contestId])
}

model UserTask {
  id                    String         @id @default(uuid())
  publicNo              Int            @unique @default(autoincrement())
  publisherId           String
  title                 String
  description           String
  category              String         @default("Other")
  privateInstructions   String?
  proofRequirements     String         @default("See task brief")
  workDurationHours     Int            @default(48)
  budgetCents           Int
  claimDeadline         DateTime
  status                TaskStatus     @default(DRAFT)
  assignedClaimId       String?        @unique
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  publisher             User           @relation("PublishedTasks", fields: [publisherId], references: [id])
  assignedClaim         TaskClaim?     @relation("AssignedTaskClaim", fields: [assignedClaimId], references: [id])
  claims                TaskClaim[]    @relation("TaskClaims")
  escrow                TaskEscrow?
  award                 Award?
  events                TaskEvent[]
  questions             TaskQuestion[]
  refunds               RefundRecord[]

  @@index([status, createdAt])
  @@index([publisherId, createdAt])
}

model TaskClaim {
  id             String                @id @default(uuid())
  taskId         String
  workerId       String
  outcome        TaskClaimOutcome?
  claimedAt      DateTime              @default(now())
  dueAt          DateTime
  reviewDueAt    DateTime?
  appealDeadline DateTime?
  revisionCount  Int                   @default(0)
  revisionReason String?
  rejectionReason String?
  appealReason   String?
  resolvedAt     DateTime?
  task           UserTask              @relation("TaskClaims", fields: [taskId], references: [id])
  assignedForTask UserTask?            @relation("AssignedTaskClaim")
  worker         User                  @relation("TaskClaimWorker", fields: [workerId], references: [id])
  submission     Submission?
  reviews        WorkReview[]

  @@index([taskId, claimedAt])
  @@index([workerId, claimedAt])
  @@index([outcome, dueAt])
}

model Submission {
  id            String      @id @default(uuid())
  claimId       String      @unique
  submitterId   String
  submittedAt   DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  claim         TaskClaim   @relation(fields: [claimId], references: [id])
  submitter     User        @relation(fields: [submitterId], references: [id])
  versions      SubmissionVersion[]
}

model SubmissionVersion {
  id           String     @id @default(uuid())
  submissionId String
  content      String
  version      Int
  createdAt    DateTime   @default(now())
  submission   Submission @relation(fields: [submissionId], references: [id])
  files        File[]

  @@unique([submissionId, version])
}

model TaskQuestion {
  id         String   @id @default(uuid())
  taskId     String
  askerId    String
  answererId String?
  question   String
  answer     String?
  createdAt  DateTime @default(now())
  answeredAt DateTime?
  task       UserTask @relation(fields: [taskId], references: [id])
  asker      User     @relation("TaskQuestionAsker", fields: [askerId], references: [id])
  answerer   User?    @relation("TaskQuestionAnswerer", fields: [answererId], references: [id])

  @@index([taskId, createdAt])
}

model ContestQuestion {
  id         String   @id @default(uuid())
  contestId  String
  askerId    String
  answererId String?
  question   String
  answer     String?
  createdAt  DateTime @default(now())
  answeredAt DateTime?
  contest    Contest  @relation(fields: [contestId], references: [id])
  asker      User     @relation("ContestQuestionAsker", fields: [askerId], references: [id])
  answerer   User?    @relation("ContestQuestionAnswerer", fields: [answererId], references: [id])

  @@index([contestId, createdAt])
}

model WorkReview {
  id           String   @id @default(uuid())
  claimId      String
  reviewerId   String
  revieweeId   String
  reviewerRole String
  content      String
  createdAt    DateTime @default(now())
  claim        TaskClaim @relation(fields: [claimId], references: [id])
  reviewer     User     @relation("ReviewsWritten", fields: [reviewerId], references: [id])
  reviewee     User     @relation("ReviewsReceived", fields: [revieweeId], references: [id])

  @@unique([claimId, reviewerId])
  @@index([revieweeId, createdAt])
}

model File {
  id                    String               @id @default(uuid())
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  userId                String
  submissionVersionId   String?
  contestEntryVersionId String?
  name                  String
  type                  String
  sizeBytes             Int                  @default(0)
  kind                  FileKind             @default(ATTACHMENT)
  status                FileStatus           @default(ATTACHED)
  targetType            FileTargetType?
  targetId              String?
  s3Key                 String               @unique
  multipartUploadId     String?
  uploadedAt            DateTime?
  attachedAt            DateTime?
  deleteAfter           DateTime?
  deleteAttempts        Int                  @default(0)
  lastDeleteError       String?
  user                  User                 @relation(fields: [userId], references: [id])
  submissionVersion     SubmissionVersion?   @relation(fields: [submissionVersionId], references: [id], onDelete: SetNull)
  contestEntryVersion   ContestEntryVersion? @relation(fields: [contestEntryVersionId], references: [id], onDelete: SetNull)

  @@index([userId, status, createdAt])
  @@index([targetType, targetId, status])
  @@index([deleteAfter, status])
}

model WalletAccount {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  rechargeAvailableCents Int      @default(0)
  earningsAvailableCents Int      @default(0)
  withdrawalFrozenCents  Int      @default(0)
  version                Int      @default(0)
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id])
}

model WalletEntry {
  id                 String   @id @default(uuid())
  userId             String
  type               String
  rechargeDeltaCents Int      @default(0)
  earningsDeltaCents Int      @default(0)
  frozenDeltaCents   Int      @default(0)
  referenceType      String
  referenceId        String
  idempotencyKey     String   @unique
  balanceSnapshot    Json
  note               String?
  createdAt          DateTime @default(now())
  user               User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model GiftCardBatch {
  id                String     @id @default(uuid())
  publicNo          Int        @unique @default(autoincrement())
  name              String
  amountCents       Int
  quantity          Int
  fundingSourceNote String
  expiresAt         DateTime?
  disabled          Boolean    @default(false)
  createdByAdminId  String
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  createdByAdmin    User       @relation("GiftCardBatchCreator", fields: [createdByAdminId], references: [id])
  cards             GiftCard[]

  @@index([createdAt])
}

model GiftCard {
  id             String        @id @default(uuid())
  publicNo       Int           @unique @default(autoincrement())
  batchId        String
  secretHmac     String        @unique
  lastFour       String
  disabled       Boolean       @default(false)
  redeemedById   String?
  redeemedAt     DateTime?
  createdAt      DateTime      @default(now())
  batch          GiftCardBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  redeemedBy     User?         @relation("GiftCardRedeemer", fields: [redeemedById], references: [id], onDelete: Restrict)

  @@index([batchId, redeemedAt])
  @@index([redeemedById, redeemedAt])
}

model RechargeOrder {
  id                    String                @id @default(uuid())
  publicNo              Int                   @unique @default(autoincrement())
  orderNo               String                @unique
  userId                String
  creditCents           Int
  feeCents              Int
  payableCents          Int
  feeRateBpsSnapshot    Int
  fixedFeeCentsSnapshot Int
  epayTradeNo           String?               @unique
  status                RechargeOrderStatus   @default(CREATED)
  paidAt                DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  user                  User                  @relation(fields: [userId], references: [id])
  notifications         PaymentNotification[]

  @@index([userId, createdAt])
}

model PaymentNotification {
  id               String         @id @default(uuid())
  orderNo          String
  epayTradeNo      String?
  payloadJson      Json
  payloadHash      String
  signatureValid   Boolean
  validationResult String
  processingResult String
  receivedAt       DateTime       @default(now())
  rechargeOrderId  String?
  order            RechargeOrder? @relation(fields: [rechargeOrderId], references: [id])

  @@index([orderNo, receivedAt])
}

model TaskEscrow {
  id            String       @id @default(uuid())
  taskId        String       @unique
  publisherId   String
  rechargeCents Int
  earningsCents Int
  totalCents    Int
  status        EscrowStatus @default(HELD)
  heldAt        DateTime     @default(now())
  releasedAt    DateTime?
  task          UserTask     @relation(fields: [taskId], references: [id])
  publisher     User         @relation("EscrowPublisher", fields: [publisherId], references: [id])
}

model Award {
  id            String      @id @default(uuid())
  taskId        String      @unique
  recipientId   String
  amountCents   Int
  status        AwardStatus @default(COOLING)
  availableAt   DateTime
  blockedReason String?
  creditedAt    DateTime?
  task          UserTask    @relation(fields: [taskId], references: [id])
  recipient     User        @relation("AwardRecipient", fields: [recipientId], references: [id])

  @@index([status, availableAt])
}

model WithdrawalRequest {
  id                    String           @id @default(uuid())
  publicNo              Int              @unique @default(autoincrement())
  userId                String
  amountCents           Int
  feeCents              Int
  payoutCents           Int
  feeRateBpsSnapshot    Int
  fixedFeeCentsSnapshot Int
  status                WithdrawalStatus @default(REQUESTED)
  tokenCiphertext       String?
  tokenIssuedAt         DateTime?
  completedAt           DateTime?
  adminId               String?
  adminNote             String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  user                  User             @relation("WithdrawalOwner", fields: [userId], references: [id])
  admin                 User?            @relation("WithdrawalAdmin", fields: [adminId], references: [id])

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model FeeConfig {
  id                   String   @id @default(uuid())
  rechargeRateBps      Int      @default(0)
  rechargeFixedCents   Int      @default(0)
  withdrawalRateBps    Int      @default(0)
  withdrawalFixedCents Int      @default(0)
  version              Int      @unique
  updatedByAdminId     String?
  updatedAt            DateTime @updatedAt
  updatedByAdmin       User?    @relation(fields: [updatedByAdminId], references: [id])
}

model SystemSetting {
  key              String   @id
  encryptedValue   String
  isSecret         Boolean  @default(false)
  updatedByAdminId String?
  updatedAt        DateTime @updatedAt
  updatedByAdmin   User?    @relation(fields: [updatedByAdminId], references: [id])

  @@index([updatedAt])
}

model RefundRecord {
  id                String    @id @default(uuid())
  taskId            String?
  recipientUserId   String
  originalReference String
  amountCents       Int
  channel           String
  externalReference String?
  reason            String
  adminId           String
  createdAt         DateTime  @default(now())
  task              UserTask? @relation(fields: [taskId], references: [id])
  admin             User      @relation(fields: [adminId], references: [id])
}

model TaskEvent {
  id           String      @id @default(uuid())
  taskId       String
  actorId      String?
  actorSource  ActorSource
  eventType    String
  beforeStatus TaskStatus?
  afterStatus  TaskStatus?
  metadata     Json
  createdAt    DateTime    @default(now())
  task         UserTask    @relation(fields: [taskId], references: [id])
  actor        User?       @relation(fields: [actorId], references: [id])

  @@index([taskId, createdAt])
}

model AdminAuditLog {
  id         String   @id @default(uuid())
  adminId    String
  action     String
  targetType String
  targetId   String
  metadata   Json
  createdAt  DateTime @default(now())

  @@index([adminId, createdAt])
}
